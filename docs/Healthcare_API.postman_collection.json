        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Lalit\",\"email\":\"{{user_email}}\",\"password\":\"StrongPass#123\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"user_email\", \"user\" + Date.now() + \"@example.com\");",
                  "pm.collectionVariables.set(\"doctor_email\", \"doc\" + Date.now() + \"@hospital.com\");"
                ]
              }
            }
          ]
        },
